// Esquema de la base de datos. Tras cambiarlo: npm run db:migrate -- --name <cambio>
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Una "run" = el equipo, la caja y el widget de un streamer. Una por cuenta (ownerEmail).
// ownerEmail null = run de antes del multiusuario; la reclama LEGACY_OWNER_EMAIL (o el usuario local).
model Run {
  id          String   @id @default(cuid())
  ownerEmail  String?  @unique
  isActive    Boolean  @default(true)
  nuzlocke    Boolean  @default(false) // debilitado = muerto: no se puede revivir
  widgetToken String   @unique // token de solo lectura para la URL de OBS

  // Configuración visual del widget (se aplica en vivo)
  layout       String  @default("hud-bottom") // hud-bottom | free
  slotPositions String @default("") // JSON: {x,y}[6] centro de cada slot en modo libre ("" = por defecto)
  opacity      Int     @default(75) // 0-100 opacidad del fondo de las tarjetas (la silueta de pokébola va en proporción)
  scale        Int     @default(100) // 80-150 %
  gap          Int     @default(12) // px entre tarjetas
  showNickname Boolean @default(true)
  showTypes    Boolean @default(true)
  faintEffect  Boolean @default(true) // escala de grises al debilitarse
  animated     Boolean @default(true) // sprites GIF animados vs PNG estáticos
  deathCounter Boolean @default(false) // contador de muertes (solo se muestra en Nuzlocke)
  deathCounterPosition String @default("") // JSON: {x,y} centro del contador ("" = por defecto)

  slots     Slot[]
  storage   Storage?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Siempre existen 6 slots por run (position 0-5). species vacío = slot vacío.
// Nombres guardados como ID de Showdown/@pkmn (ej. "charizardmegax", "heavydutyboots").
model Slot {
  id        String  @id @default(cuid())
  runId     String
  run       Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  position  Int
  species   String  @default("")
  nickname  String  @default("")
  ability   String  @default("")
  item      String  @default("")
  nature    String  @default("")
  teraType  String  @default("")
  gender    String  @default("") // "", "M", "F"
  shiny     Boolean @default(false)
  fainted   Boolean @default(false)
  moves     String  @default("[]") // JSON: string[] (máx. 4)
  evs       String  @default("")   // JSON: StatsTable o "" si no aplica
  ivs       String  @default("")   // JSON: StatsTable o "" si no aplica

  updatedAt DateTime @updatedAt

  @@unique([runId, position])
}

// Caja y Pokémon muertos (Nuzlocke) de la run, guardados como texto Showdown (compacto).
// Todo Pokémon que sale del equipo va a `box`; si estaba muerto en Nuzlocke, a `graveyard`.
model Storage {
  runId     String @id
  run       Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  box       String @default("")
  graveyard String @default("")
}

// Control de acceso (dueña: feature auth). Una fila por correo invitado, bloqueado o que ya entró.
// Los admins (ADMIN_EMAILS en .env) siempre pueden entrar.
model Access {
  email       String    @id
  invited     Boolean   @default(false)
  blocked     Boolean   @default(false) // sin panel ni widget
  lastLoginAt DateTime? // último inicio de sesión con Google
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ajustes de acceso (una sola fila, id = 1). Dueña: feature auth.
model AccessSettings {
  id               Int     @id @default(1)
  registrationOpen Boolean @default(false) // false = solo invitados (beta cerrada)
}

// Sesiones del panel. La cookie lleva el id firmado; borrar la fila cierra la sesión (logout real).
model Session {
  id        String   @id
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Preregistro a la beta (postulantes sin acceso aún). Dueña: feature waitlist.
// Aprobar = invitar el correo en Access; la fila queda como historial.
model BetaApplication {
  email      String    @id // correo de Google con el que entrará (normalizado)
  name       String? // nombre o apodo
  platform   String // twitch | kick | youtube | other
  channel    String // usuario del canal (o URL si platform = other)
  message    String? // por qué quiere entrar / cómo nos conoció
  status     String    @default("pending") // pending | approved | rejected
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
}

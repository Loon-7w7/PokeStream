# Nombre visible de la app (cámbialo cuando elijas el nombre final)
APP_NAME="PokeStream"

# Base de datos SQLite. En Docker se sobrescribe a file:/app/data/app.db
# Remota (Turso/libsql): libsql://... o https://... y el token aparte en DATABASE_AUTH_TOKEN
DATABASE_URL="file:./data/app.db"
DATABASE_AUTH_TOKEN=""

# URL pública de la app (sin "/" final). En local: http://localhost:3000
APP_URL="http://localhost:3000"

# Login con Google (Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth "Aplicación web").
# URI de redireccionamiento autorizado: {APP_URL}/api/auth/google/callback
# Deja GOOGLE_CLIENT_ID vacío para desactivar el login (solo en local).
# En producción sin login el servidor no arranca, salvo que pongas ALLOW_NO_AUTH="true".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Cadena aleatoria de 32+ caracteres. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarla cierra todas las sesiones.
SESSION_SECRET=""
# Cada cuenta de Google tiene su propio equipo y widget.
# Administradores (separados por comas): entran siempre y en /admin gestionan el acceso
# (registro abierto o solo invitados, invitaciones y bloqueos). Por defecto: solo invitados.
ADMIN_EMAILS="loonswitch7@gmail.com"
# Tu correo: se queda con el equipo que existía antes del multiusuario.
LEGACY_OWNER_EMAIL="loonswitch7@gmail.com"

# Donaciones (vacío = sin botón) y contacto de la política de privacidad
KOFI_URL="https://ko-fi.com/lonyarts"
CONTACT_EMAIL=""

# Docker: dónde escucha el puerto 3000. Por defecto solo esta máquina (127.0.0.1).
# 0.0.0.0 lo abre a tu red local (OBS en otra PC por IP). Con túnel déjalo en 127.0.0.1.
APP_BIND="127.0.0.1"

# Cloudflare Tunnel con dominio fijo (docs/DEPLOY-LAPTOP.md). Vacío = URL temporal *.trycloudflare.com
TUNNEL_TOKEN=""

# URL base de los sprites. Se concatena: {base}{carpeta}/{spriteid}.{gif|png}
SPRITES_BASE_URL="https://play.pokemonshowdown.com/sprites/"

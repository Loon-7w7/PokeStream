# Nombre visible de la app (cámbialo cuando elijas el nombre final)
APP_NAME="PokeStream"

# Base de datos SQLite. En Docker se sobrescribe a file:/app/data/app.db
DATABASE_URL="file:./data/app.db"

# URL pública de la app (sin "/" final). En local: http://localhost:3000
APP_URL="http://localhost:3000"

# Login con Google (Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth "Aplicación web").
# URI de redireccionamiento autorizado: {APP_URL}/api/auth/google/callback
# Deja GOOGLE_CLIENT_ID vacío para desactivar el login (solo en local).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Cadena aleatoria de 32+ caracteres. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarla cierra todas las sesiones.
SESSION_SECRET=""
# Correos que pueden entrar al panel, separados por comas. Todos comparten el mismo equipo.
ALLOWED_EMAILS=""

# URL base de los sprites. Se concatena: {base}{carpeta}/{spriteid}.{gif|png}
SPRITES_BASE_URL="https://play.pokemonshowdown.com/sprites/"
